# Copy to .env and export the values before starting SahilOps, e.g.
#   set -a; source .env; set +a; python -m core.app

# ── Dashboard ────────────────────────────────────────────────
# Bind address (keep 127.0.0.1 unless you really need LAN access).
SAHILOPS_HOST=127.0.0.1
# Control-panel key required in the X-API-Key header for every write route.
SAHILOPS_API_KEY=SAHILOPS

# ── Storage ──────────────────────────────────────────────────
# SQLite database with accounts, device fingerprints, sessions, and health.
SAHILOPS_DB=./sahilops.db

# ── Alerts (optional) ────────────────────────────────────────
# Discord webhook URL or Telegram bot sendMessage URL. Alerts are disabled
# when this is empty.
SAHILOPS_WEBHOOK_URL=
# Required for Telegram, ignored for Discord.
SAHILOPS_TELEGRAM_CHAT_ID=
SAHILOPS_WEBHOOK_TIMEOUT=5
SAHILOPS_WEBHOOK_MIN_INTERVAL=1.0

# ── Account health ───────────────────────────────────────────
# Consecutive failures before an account is quarantined (worker stops).
SAHILOPS_ERROR_THRESHOLD=5
# Gateway/OAuth error codes treated as a ban or restriction.
SAHILOPS_BAN_CODES=1004,1005,1006,2003,2004
